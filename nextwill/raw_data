"""FMCW 레이더로 여러 대의 드론에 대한 원시 I/Q 신호를 생성하는 예제입니다.

드론별 거리·속도·프로펠러 회전에 따른 복소 I/Q 비트 신호를 생성합니다.
푸리에 변환, Range-Doppler 처리 및 STFT 분석은 포함하지 않습니다.
"""

# 수치 배열과 복소 신호 계산에 사용하는 라이브러리
import numpy as np

# ============================================================
# 1. FMCW 레이더 파라미터
# ============================================================
# 진공에서의 빛의 속도 [m/s]
c = 3e8
# 레이더 반송파의 중심주파수 [Hz]
fc = 77e9
# 반송파 파장 [m]: 드론 본체의 도플러 주파수를 계산할 때 사용
lam = c / fc

# 한 Chirp 동안 변화하는 주파수 대역폭 [Hz]
B = 150e6
# 단일 Chirp의 지속시간 [s]
Tc = 50e-6
# Chirp 주파수 변화율 [Hz/s]
S = B / Tc

# Chirp 하나에서 획득하는 ADC 샘플 수(Fast-time 방향)
Nr = 256
# 한 프레임에서 송신하는 Chirp 수(Slow-time 방향)
Nd = 128
# ADC 샘플링 주파수 [Hz]: Chirp 시간 동안 Nr개의 샘플을 획득
Fs = Nr / Tc

# ============================================================
# 2. 드론 및 프로펠러 파라미터
# ============================================================
# 프로펠러 회전 속도 [revolutions per minute]
rpm = 3600
# 초당 프로펠러 회전수 [Hz]; 3600 rpm은 60 Hz
f_rot = rpm / 60
# 프로펠러 반지름 [m]. 현재 단순 모델에서는 참고용 파라미터입니다.
prop_radius = 0.10
# 한 드론에 존재하는 로터 개수
num_rotors = 4

# 프로펠러 회전이 전체 위상에 가하는 Micro-Doppler 변조 강도
micro_amp = 0.25

# ============================================================
# 3. 시간축 구성
# ============================================================
# 한 Chirp 내부의 ADC 샘플 시간축 [s], 형상: (Nr,)
t_fast = np.arange(Nr) / Fs
# Chirp가 반복되는 프레임의 Slow-time 시간축 [s], 형상: (Nd,)
t_slow = np.arange(Nd) * Tc

# 각 Chirp와 각 ADC 샘플의 절대시간을 나타내는 2차원 격자
# 브로드캐스팅 결과 형상은 (Nd, Nr) = (Chirp, ADC sample)입니다.
t = t_slow[:, None] + t_fast[None, :]

# ============================================================
# 4. 단일 드론의 FMCW 비트 신호 모델
# ============================================================
def generate_drone_signal(R0, v, amplitude=1.0):
    """단일 드론에서 반사된 단순화된 FMCW 복소 비트 신호를 생성합니다.

    Args:
        R0: 레이더와 드론 사이의 초기 거리 [m].
        v: 드론의 방사 속도 [m/s]. 양수는 멀어지는 방향이고 음수는 접근 방향입니다.
        amplitude: 드론 반사 신호의 상대적인 크기.

    Returns:
        Chirp와 ADC 샘플로 구성된 형상 ``(Nd, Nr)``의 복소 I/Q 신호.
    """

    # 등속 운동을 가정하여 전체 관측시간 동안 변하는 드론 거리를 계산합니다.
    R = R0 + v * t

    # FMCW 거리 정보가 포함된 비트 주파수 [Hz]: fb = 2*S*R/c
    fb = 2 * S * R / c

    # 드론 본체의 왕복 전파 경로에 따른 도플러 주파수 [Hz]
    fd = 2 * v / lam

    # 거리 비트 위상과 본체 도플러 위상을 합산합니다.
    # 거리 성분은 Chirp 내부 시간(t_fast), 도플러 성분은 전체 시간(t)에 누적됩니다.
    phase_body = 2 * np.pi * (fb * t_fast[None, :] + fd * t)

    # 모든 로터의 회전에 의해 추가되는 Micro-Doppler 위상을 저장할 배열입니다.
    micro_phase = np.zeros_like(t)

    # 각 로터가 서로 다른 초기 회전 위상을 갖는다고 가정합니다.
    for rotor_idx in range(num_rotors):
        # 로터를 한 바퀴(2π) 안에서 같은 각도 간격으로 배치합니다.
        rotor_phase_offset = rotor_idx * 2 * np.pi / num_rotors

        # 프로펠러 날개의 주기적 운동을 단순한 사인 위상 변조로 모델링합니다.
        micro_phase += micro_amp * np.sin(
            2 * np.pi * f_rot * t + rotor_phase_offset
        )

    # 본체 및 프로펠러 위상을 복소 지수로 변환하여 I/Q 비트 신호를 만듭니다.
    signal = amplitude * np.exp(1j * (phase_body + micro_phase))

    # 생성된 단일 드론 신호를 장면 생성 함수로 반환합니다.
    return signal

# ============================================================
# 5. 다중 드론 장면 및 원시 ADC 데이터 생성
# ============================================================
def generate_scene(num_drones):
    """1~3대 드론의 반사 신호와 잡음이 합쳐진 원시 ADC I/Q 데이터를 생성합니다.

    Args:
        num_drones: 아래 시나리오 목록에서 사용할 드론의 수.

    Returns:
        형상 ``(Nd, Nr)``의 복소 원시 ADC 데이터.
    """

    # 각 드론의 초기 거리 [m], 방사 속도 [m/s], 상대 반사 크기를 정의합니다.
    drones = [
        # 30 m 위치에서 10 m/s로 멀어지는 첫 번째 드론
        {"R0": 30, "v": 10, "amp": 1.0},
        # 45 m 위치에서 6 m/s로 접근하는 두 번째 드론
        {"R0": 45, "v": -6, "amp": 0.8},
        # 60 m 위치에서 15 m/s로 멀어지는 세 번째 드론
        {"R0": 60, "v": 15, "amp": 0.7},
    ]

    # 모든 드론 신호를 누적할 복소 배열을 0으로 초기화합니다.
    raw = np.zeros((Nd, Nr), dtype=np.complex128)

    # 요청한 수만큼 드론 신호를 생성하여 선형적으로 중첩합니다.
    for drone in drones[:num_drones]:
        raw += generate_drone_signal(
            R0=drone["R0"],
            v=drone["v"],
            amplitude=drone["amp"]
        )

    # 수신기 열잡음 등을 표현하는 복소 백색 가우시안 잡음을 추가합니다.
    noise_power = 0.05
    # 실수부와 허수부에 잡음 전력을 절반씩 배분합니다.
    noise = np.sqrt(noise_power / 2) * (
        np.random.randn(Nd, Nr) + 1j * np.random.randn(Nd, Nr)
    )

    # 드론 반사 신호와 잡음을 합쳐 최종 원시 ADC 데이터를 구성합니다.
    raw += noise

    return raw
