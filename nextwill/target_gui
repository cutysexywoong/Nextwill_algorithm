"""(x, y, z) 거리 좌표를 입력하여 레이더 기준 타깃을 표시하는 3D GUI."""

import math
import tkinter as tk
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
from tkinter import messagebox, ttk

import matplotlib
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
from matplotlib.figure import Figure


matplotlib.rcParams["font.family"] = ["Malgun Gothic", "DejaVu Sans"]
matplotlib.rcParams["axes.unicode_minus"] = False

HORIZONTAL_ANGLE_MIN_DEG = -50.0
HORIZONTAL_ANGLE_MAX_DEG = 50.0
VERTICAL_ANGLE_MIN_DEG = 0.0
VERTICAL_ANGLE_MAX_DEG = 50.0


def _load_radar_icon_drawer():
    """확장자가 없는 radar_icon 파일에서 3D 레이더 그리기 함수를 불러옵니다."""
    radar_icon_path = Path(__file__).resolve().with_name("radar_icon")
    if not radar_icon_path.exists():
        raise FileNotFoundError(f"3D 레이더 아이콘 파일이 없습니다: {radar_icon_path}")

    loader = SourceFileLoader("nextwill_radar_icon", str(radar_icon_path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:
        raise ImportError(f"3D 레이더 아이콘을 불러올 수 없습니다: {radar_icon_path}")

    module = module_from_spec(spec)
    loader.exec_module(module)
    return module.draw_3d_radar


def _load_drone_icon_drawer():
    """확장자가 없는 drone_icon 파일에서 3D 드론 그리기 함수를 불러옵니다."""
    drone_icon_path = Path(__file__).resolve().with_name("drone_icon")
    if not drone_icon_path.exists():
        raise FileNotFoundError(f"3D 드론 아이콘 파일이 없습니다: {drone_icon_path}")

    loader = SourceFileLoader("nextwill_drone_icon", str(drone_icon_path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:
        raise ImportError(f"3D 드론 아이콘을 불러올 수 없습니다: {drone_icon_path}")

    module = module_from_spec(spec)
    loader.exec_module(module)
    return module.draw_3d_drone


draw_3d_radar = _load_radar_icon_drawer()
draw_3d_drone = _load_drone_icon_drawer()


class TargetPlotApp:
    """문자열로 입력한 (x, y, z) 좌표를 3차원 공간에 표시합니다."""

    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title("3D Radar Target Coordinate Plot")

        # X는 좌우, Y는 레이더 정면, Z는 높이 방향입니다.
        self.var_coordinate = tk.StringVar(value="(2, 3, 1)")
        self.var_horizontal_angle = tk.DoubleVar(value=33.69)
        self.var_vertical_angle = tk.DoubleVar(value=15.50)
        self.var_result = tk.StringVar(
            value="(x, y, z) 좌표를 입력한 뒤 Target Plot을 누르세요."
        )

        self._build_plot()
        self._build_controls()
        self.plot_target()

    def _build_plot(self):
        """3차원 Matplotlib 그래프를 Tkinter 창에 삽입합니다."""
        self.figure = Figure(figsize=(8, 6), dpi=100)
        self.ax = self.figure.add_subplot(111, projection="3d")

        self.canvas = FigureCanvasTkAgg(self.figure, master=self.root)
        self.canvas.get_tk_widget().pack(
            side=tk.TOP,
            fill=tk.BOTH,
            expand=True,
            padx=10,
            pady=(10, 4),
        )

    def _build_controls(self):
        """3차원 좌표 입력란과 실행 버튼을 구성합니다."""
        panel = ttk.LabelFrame(
            self.root,
            text="타깃 좌표 Target coordinate [km]",
            padding=10,
        )
        panel.pack(side=tk.TOP, fill=tk.X, padx=10, pady=6)

        ttk.Label(panel, text="좌표 (x, y, z)").pack(side=tk.LEFT, padx=(4, 8))

        self.coordinate_entry = ttk.Entry(
            panel,
            textvariable=self.var_coordinate,
            width=28,
            font=("Consolas", 11),
        )
        self.coordinate_entry.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=4)
        self.coordinate_entry.bind("<Return>", self.plot_target)

        ttk.Button(
            panel,
            text="● Target Plot",
            command=self.plot_target,
        ).pack(side=tk.LEFT, padx=(12, 4))

        ttk.Button(
            panel,
            text="Clear",
            command=self.clear_plot,
        ).pack(side=tk.LEFT, padx=4)

        # 레이더 정면(+Y축)을 0도로 하는 수평각 설정 패널입니다.
        angle_panel = ttk.LabelFrame(
            self.root,
            text="수평각 Horizontal angle [-50° ~ +50°]",
            padding=10,
        )
        angle_panel.pack(side=tk.TOP, fill=tk.X, padx=10, pady=(0, 6))

        ttk.Label(angle_panel, text="Left -50°").pack(side=tk.LEFT, padx=(4, 8))
        self.angle_scale = ttk.Scale(
            angle_panel,
            from_=HORIZONTAL_ANGLE_MIN_DEG,
            to=HORIZONTAL_ANGLE_MAX_DEG,
            variable=self.var_horizontal_angle,
            orient=tk.HORIZONTAL,
            command=self._on_angle_scale,
        )
        self.angle_scale.pack(side=tk.LEFT, fill=tk.X, expand=True)
        ttk.Label(angle_panel, text="Right +50°").pack(side=tk.LEFT, padx=8)

        self.angle_entry = ttk.Entry(angle_panel, width=9)
        self.angle_entry.insert(0, f"{self.var_horizontal_angle.get():.2f}")
        self.angle_entry.pack(side=tk.LEFT, padx=(4, 2))
        ttk.Label(angle_panel, text="°").pack(side=tk.LEFT)
        self.angle_entry.bind("<Return>", self._on_angle_entry)

        # X-Y 평면을 0도로 하는 수직각 설정 패널입니다.
        vertical_panel = ttk.LabelFrame(
            self.root,
            text="수직각 Vertical angle [0° ~ 50°]",
            padding=10,
        )
        vertical_panel.pack(side=tk.TOP, fill=tk.X, padx=10, pady=(0, 6))

        ttk.Label(vertical_panel, text="Horizontal 0°").pack(
            side=tk.LEFT,
            padx=(4, 8),
        )
        self.vertical_scale = ttk.Scale(
            vertical_panel,
            from_=VERTICAL_ANGLE_MIN_DEG,
            to=VERTICAL_ANGLE_MAX_DEG,
            variable=self.var_vertical_angle,
            orient=tk.HORIZONTAL,
            command=self._on_vertical_scale,
        )
        self.vertical_scale.pack(side=tk.LEFT, fill=tk.X, expand=True)
        ttk.Label(vertical_panel, text="Up +50°").pack(side=tk.LEFT, padx=8)

        self.vertical_entry = ttk.Entry(vertical_panel, width=9)
        self.vertical_entry.insert(0, f"{self.var_vertical_angle.get():.2f}")
        self.vertical_entry.pack(side=tk.LEFT, padx=(4, 2))
        ttk.Label(vertical_panel, text="°").pack(side=tk.LEFT)
        self.vertical_entry.bind("<Return>", self._on_vertical_entry)

        ttk.Label(
            self.root,
            textvariable=self.var_result,
            relief=tk.SUNKEN,
            anchor="w",
            padding=6,
        ).pack(side=tk.BOTTOM, fill=tk.X)

    def _read_coordinate(self):
        """'(x, y, z)' 문자열에서 유한한 실수 좌표 세 개를 추출합니다."""
        coordinate_text = self.var_coordinate.get().strip()

        # 괄호 포함 '(3, 2, 1)'과 괄호 없는 '3, 2, 1'을 모두 허용합니다.
        if coordinate_text.startswith("(") and coordinate_text.endswith(")"):
            coordinate_text = coordinate_text[1:-1].strip()

        parts = [part.strip() for part in coordinate_text.split(",")]
        if len(parts) != 3:
            raise ValueError(
                "좌표를 (x, y, z) 형식으로 입력하세요. 예: (3, 2, 1)"
            )

        try:
            x, y, z = (float(part) for part in parts)
        except ValueError as error:
            raise ValueError("x, y, z에는 숫자를 입력해야 합니다.") from error

        if not all(math.isfinite(value) for value in (x, y, z)):
            raise ValueError("x, y, z에는 유한한 숫자를 입력해야 합니다.")

        if not (-5.0 <= x <= 5.0):
            raise ValueError("x는 -5~5 km 범위여야 합니다.")
        if not (0.0 <= y <= 5.0):
            raise ValueError("y는 0~5 km 범위여야 합니다.")
        if not (0.0 <= z <= 5.0):
            raise ValueError("z는 0~5 km 범위여야 합니다.")

        horizontal_distance = math.hypot(x, y)
        if horizontal_distance > 5.0:
            raise ValueError("X-Y 평면의 수평거리는 5 km 이하여야 합니다.")

        distance = math.sqrt(x**2 + y**2 + z**2)
        if distance > 5.0:
            raise ValueError("레이더와 타깃의 직선거리는 5 km 이하여야 합니다.")

        horizontal_angle_deg = math.degrees(math.atan2(x, y))
        if not (
            HORIZONTAL_ANGLE_MIN_DEG
            <= horizontal_angle_deg
            <= HORIZONTAL_ANGLE_MAX_DEG
        ):
            raise ValueError("수평각은 -50°~+50° 범위여야 합니다.")

        vertical_angle_deg = math.degrees(math.atan2(z, horizontal_distance))
        if not (
            VERTICAL_ANGLE_MIN_DEG <= vertical_angle_deg <= VERTICAL_ANGLE_MAX_DEG
        ):
            raise ValueError("수직각은 0°~50° 범위여야 합니다.")

        return x, y, z

    def _on_angle_scale(self, value):
        """슬라이더로 지정한 수평각을 현재 타깃 좌표에 적용합니다."""
        self._apply_horizontal_angle(float(value), show_error=False)

    def _on_angle_entry(self, _event=None):
        """직접 입력한 수평각을 검사하고 현재 타깃 좌표에 적용합니다."""
        try:
            angle_deg = float(self.angle_entry.get())
        except ValueError:
            messagebox.showerror(
                "입력 오류",
                "수평각에는 숫자를 입력해야 합니다.",
                parent=self.root,
            )
            return

        if not math.isfinite(angle_deg) or not (
            HORIZONTAL_ANGLE_MIN_DEG
            <= angle_deg
            <= HORIZONTAL_ANGLE_MAX_DEG
        ):
            messagebox.showerror(
                "입력 오류",
                "수평각은 -50°~+50° 범위여야 합니다.",
                parent=self.root,
            )
            return

        self._apply_horizontal_angle(angle_deg, show_error=True)

    def _apply_horizontal_angle(self, angle_deg, show_error):
        """수평거리와 Z 높이는 유지하고 수평각에 맞게 X·Y를 재계산합니다."""
        try:
            x, y, z = self._read_coordinate()
        except ValueError as error:
            if show_error:
                messagebox.showerror("입력 오류", str(error), parent=self.root)
            return

        horizontal_distance = math.hypot(x, y)
        angle_rad = math.radians(angle_deg)

        # +Y축이 0도이며, 음수 X는 왼쪽, 양수 X는 오른쪽입니다.
        new_x = horizontal_distance * math.sin(angle_rad)
        new_y = horizontal_distance * math.cos(angle_rad)
        self.var_coordinate.set(f"({new_x:.4f}, {new_y:.4f}, {z:g})")
        self.var_horizontal_angle.set(angle_deg)
        self.angle_entry.delete(0, tk.END)
        self.angle_entry.insert(0, f"{angle_deg:.2f}")
        self.plot_target()

    def _on_vertical_scale(self, value):
        """슬라이더로 지정한 수직각을 현재 타깃 좌표에 적용합니다."""
        self._apply_vertical_angle(float(value), show_error=False)

    def _on_vertical_entry(self, _event=None):
        """직접 입력한 수직각을 검사하고 현재 타깃 좌표에 적용합니다."""
        try:
            angle_deg = float(self.vertical_entry.get())
        except ValueError:
            messagebox.showerror(
                "입력 오류",
                "수직각에는 숫자를 입력해야 합니다.",
                parent=self.root,
            )
            return

        if not math.isfinite(angle_deg) or not (
            VERTICAL_ANGLE_MIN_DEG <= angle_deg <= VERTICAL_ANGLE_MAX_DEG
        ):
            messagebox.showerror(
                "입력 오류",
                "수직각은 0°~50° 범위여야 합니다.",
                parent=self.root,
            )
            return

        self._apply_vertical_angle(angle_deg, show_error=True)

    def _apply_vertical_angle(self, angle_deg, show_error):
        """직선거리와 수평 방향은 유지하고 수직각에 맞게 좌표를 계산합니다."""
        try:
            x, y, z = self._read_coordinate()
        except ValueError as error:
            if show_error:
                messagebox.showerror("입력 오류", str(error), parent=self.root)
            return

        distance = math.sqrt(x**2 + y**2 + z**2)
        horizontal_angle_rad = math.atan2(x, y)
        vertical_angle_rad = math.radians(angle_deg)

        new_horizontal_distance = distance * math.cos(vertical_angle_rad)
        new_z = distance * math.sin(vertical_angle_rad)
        new_x = new_horizontal_distance * math.sin(horizontal_angle_rad)
        new_y = new_horizontal_distance * math.cos(horizontal_angle_rad)

        self.var_coordinate.set(
            f"({new_x:.4f}, {new_y:.4f}, {new_z:.4f})"
        )
        self.var_vertical_angle.set(angle_deg)
        self.vertical_entry.delete(0, tk.END)
        self.vertical_entry.insert(0, f"{angle_deg:.2f}")
        self.plot_target()

    def plot_target(self, _event=None):
        """입력한 타깃과 레이더 원점을 3차원 공간에 표시합니다."""
        try:
            x, y, z = self._read_coordinate()
        except ValueError as error:
            messagebox.showerror("입력 오류", str(error), parent=self.root)
            return

        horizontal_distance = math.hypot(x, y)
        distance = math.sqrt(x**2 + y**2 + z**2)
        # 레이더 정면인 +Y축을 0도로 하는 수평각입니다.
        horizontal_angle_deg = math.degrees(math.atan2(x, y))
        elevation_deg = math.degrees(math.atan2(z, horizontal_distance))

        self.ax.clear()

        # radar_icon의 3D 레이더 모델을 원점에 배치하고 타깃 방향으로 조준합니다.
        draw_3d_radar(
            self.ax,
            position=(0.0, 0.0, 0.0),
            scale=0.22,
            azimuth_deg=horizontal_angle_deg,
            elevation_deg=elevation_deg,
            show_beam=False,
        )
        self.ax.text(0.0, 0.0, 0.45, "Radar", color="#263238", ha="center")

        # drone_icon의 3D 드론 모델을 사용자가 입력한 타깃 위치에 배치합니다.
        draw_3d_drone(
            self.ax,
            position=(x, y, z),
            scale=0.18,
            yaw_deg=horizontal_angle_deg,
            rotor_phase_deg=25.0,
        )
        self.ax.text(
            x,
            y,
            z + 0.32,
            f"Target ({x:g}, {y:g}, {z:g}) km",
            color="#d32f2f",
            ha="center",
            weight="bold",
        )

        # 원점에서 타깃까지의 3차원 직선거리를 점선으로 표시합니다.
        self.ax.plot(
            [0, x],
            [0, y],
            [0, z],
            linestyle="--",
            color="#555555",
            label=f"Range = {distance:.2f} km",
            zorder=2,
        )

        # 타깃을 X-Y 평면에 투영하여 수평 좌표를 쉽게 파악하게 합니다.
        self.ax.plot(
            [x, x],
            [y, y],
            [0, z],
            linestyle=":",
            color="#2ca02c",
        )
        self.ax.scatter(
            x,
            y,
            0,
            s=45,
            color="#2ca02c",
            alpha=0.65,
            label="X-Y projection",
        )

        self._format_axes()
        self.ax.legend(loc="upper right")
        self.figure.tight_layout()
        self.canvas.draw_idle()

        self.var_coordinate.set(f"({x:g}, {y:g}, {z:g})")
        self.var_horizontal_angle.set(horizontal_angle_deg)
        self.angle_entry.delete(0, tk.END)
        self.angle_entry.insert(0, f"{horizontal_angle_deg:.2f}")
        self.var_vertical_angle.set(elevation_deg)
        self.vertical_entry.delete(0, tk.END)
        self.vertical_entry.insert(0, f"{elevation_deg:.2f}")
        self.var_result.set(
            f"Target: ({x:.2f}, {y:.2f}, {z:.2f}) km  |  "
            f"직선거리={distance:.2f} km  |  "
            f"수평각={horizontal_angle_deg:.2f}°  |  고각={elevation_deg:.2f}°"
        )

    def _format_axes(self):
        """사용자가 지정한 3차원 감시 범위와 축 형식을 적용합니다."""
        self.ax.set_xlim(-5, 5)
        self.ax.set_ylim(0, 5)
        self.ax.set_zlim(0, 5)

        # 마우스 드래그로 3D 시점이 회전하지 않도록 축 UI 위치를 고정합니다.
        self.ax.view_init(elev=24, azim=-58)
        self.ax.disable_mouse_rotation()
        self.ax.set_navigate(False)

        # X축 폭이 Y/Z축의 두 배이므로 실제 범위 비율을 반영합니다.
        self.ax.set_box_aspect((2, 1, 1))
        self.ax.set_xlabel("X 거리 [km]")
        self.ax.set_ylabel("Y 거리 [km]")
        self.ax.set_zlabel("Z 높이 [km]")
        self.ax.set_title("3D Radar Target Position")
        self.ax.grid(True, linestyle="--", alpha=0.3)

    def clear_plot(self):
        """좌표와 3차원 그래프를 초기화합니다."""
        self.var_coordinate.set("")
        self.var_horizontal_angle.set(0.0)
        self.angle_entry.delete(0, tk.END)
        self.angle_entry.insert(0, "0.00")
        self.var_vertical_angle.set(0.0)
        self.vertical_entry.delete(0, tk.END)
        self.vertical_entry.insert(0, "0.00")
        self.ax.clear()
        self._format_axes()
        self.figure.tight_layout()
        self.canvas.draw_idle()
        self.var_result.set("좌표가 초기화되었습니다.")
        self.coordinate_entry.focus_set()


def main():
    root = tk.Tk()
    try:
        ttk.Style().theme_use("vista")
    except tk.TclError:
        pass

    TargetPlotApp(root)
    root.minsize(800, 700)
    root.mainloop()


if __name__ == "__main__":
    main()
